{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "butler.ac25.cross_track_approval.v2",
  "title": "Cross-track approval (v2)",
  "description": "정오표 v1.2 §E2 반영. 두 기준선을 한 칸에 넣지 않는다. integration_base_sha 는 통합 비교 기준, provenance_base_sha·provenance_base_tree 는 경로를 판정하는 승인 기준이다. 두 base 가 서로 같기를 요구하지 않으며 한 칸에 넣으면 BASELINE_ROLE_MISMATCH 로 닫는다. issued_at 은 문서에 적지 않는다(§E3: 승인 커밋 committer 시각을 정본으로 쓴다).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "integration_base_sha", "provenance_base_sha", "provenance_base_tree",
    "candidate_head_sha", "candidate_head_tree",
    "identity_artifact_zip_sha256", "identity_manifest_sha256",
    "approved_paths",
    "source_repo", "protected_ref", "document_path",
    "approval_commit_sha", "document_sha256",
    "approver_login", "approver_id",
    "signature_path", "allowed_signers_path",
    "signing_key_fingerprint", "signature_namespace",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "const": "butler.ac25.cross_track_approval.v2" },

    "integration_base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "provenance_base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "provenance_base_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },

    "candidate_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_head_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },

    "identity_artifact_zip_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identity_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },

    "approved_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },

    "source_repo": { "type": "string", "minLength": 1 },
    "protected_ref": { "type": "string", "minLength": 1 },
    "document_path": { "type": "string", "minLength": 1 },
    "approval_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "document_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },

    "approver_login": { "type": "string", "minLength": 1 },
    "approver_id": { "type": "integer", "minimum": 1 },

    "signature_path": { "type": "string", "minLength": 1 },
    "allowed_signers_path": { "type": "string", "minLength": 1 },
    "signing_key_fingerprint": { "type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$" },
    "signature_namespace": { "const": "butler-approval" },

    "expires_at": { "type": "string", "pattern": "Z$" }
  }
}
