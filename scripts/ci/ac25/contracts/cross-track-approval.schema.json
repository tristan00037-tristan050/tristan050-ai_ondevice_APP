{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "butler.ac25.cross_track_approval.v1",
  "title": "Cross-track approval",
  "description": "교차 트랙 승인서. 좌표 매칭 축은 head_sha·head_tree(승인 문서 §10). base_sha 는 통합 비교 base 로만 대조하며 잠금 base 와 섞지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_repo", "protected_ref", "approval_commit_sha",
    "document_path", "document_sha256", "approver_login", "approver_id",
    "base_sha", "base_tree", "head_sha", "head_tree",
    "approved_paths", "issued_at", "expires_at"
  ],
  "properties": {
    "schema_version": { "const": "butler.ac25.cross_track_approval.v1" },
    "source_repo": { "type": "string", "minLength": 1 },
    "protected_ref": { "type": "string", "minLength": 1 },
    "approval_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "document_path": { "type": "string", "minLength": 1 },
    "document_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "approver_login": { "type": "string", "minLength": 1 },
    "approver_id": { "type": "integer", "minimum": 1 },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "base_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "head_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "approved_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "issued_at": { "type": "string", "pattern": "Z$" },
    "expires_at": { "type": "string", "pattern": "Z$" }
  }
}
