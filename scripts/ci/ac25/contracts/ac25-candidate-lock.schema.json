{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "butler.ac25.candidate_lock.v1",
  "title": "AC-25 candidate lock",
  "description": "PR #903 후보를 승인 좌표와 identity 산출물에 결속하는 보호 잠금. 값은 lock_verifier.load_candidate_lock 이 엄격 검증한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "repository", "pr_number",
    "approved_base_commit", "approved_base_tree",
    "approved_head_commit", "approved_head_tree",
    "allowed_paths", "identity_manifest_sha256",
    "identity_artifact_zip_sha256", "created_at", "expires_at"
  ],
  "properties": {
    "schema_version": { "const": "butler.ac25.candidate_lock.v1" },
    "repository": { "type": "string", "minLength": 1 },
    "pr_number": { "type": "integer", "minimum": 1 },
    "approved_base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "approved_base_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "approved_head_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "approved_head_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$)).+$" }
    },
    "identity_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identity_artifact_zip_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "created_at": { "type": "string", "pattern": "Z$" },
    "expires_at": { "type": "string", "pattern": "Z$" }
  }
}
