{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Box3 real human approval v1",
  "type": "object",
  "required": [
    "allow",
    "kill_switch",
    "revoked",
    "approved_by_digest",
    "approval_scope_digest",
    "expires_at"
  ],
  "properties": {
    "allow": {
      "type": "boolean"
    },
    "kill_switch": {
      "type": "boolean"
    },
    "revoked": {
      "type": "boolean"
    },
    "approved_by_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "approval_scope_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(Z|[+-](0\\d|1[0-4]):[0-5]\\d)$"
    }
  },
  "additionalProperties": false
}