{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/schemas/candidate-artifact-identity-v1.schema.json",
  "title": "Butler AC-23 candidate and artifact identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "digest_algorithm",
    "repository_url",
    "object_format",
    "base_commit",
    "base_tree",
    "head_commit",
    "head_tree",
    "submitted_head_tree",
    "patch_applied_tree",
    "source_archive_tree",
    "patch_sha256",
    "source_archive_sha256",
    "changed_path_manifest_sha256",
    "evidence_sha256",
    "normative_contract_path",
    "normative_contract_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "butler.box5.candidate-artifact-identity.v1"
    },
    "digest_algorithm": {
      "const": "sha256"
    },
    "repository_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "object_format": {
      "const": "sha1"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "submitted_head_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "patch_applied_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_archive_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "patch_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "changed_path_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "normative_contract_path": {
      "const": "butler_pc_core/accounting/assignment/contracts/authorization-replay-v2.sql"
    },
    "normative_contract_sha256": {
      "const": "b0e11b52b7efd3d74c41fcfb46726312ba442c2dfa7a7a04203f7424342bd729"
    }
  }
}
