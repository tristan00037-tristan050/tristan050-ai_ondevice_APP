{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/schemas/model_tier/device_profile.schema.json",
  "title": "Butler device profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "architecture", "chip_family", "total_memory_bytes", "available_memory_bytes", "process_rss_bytes", "memory_pressure", "thermal_state", "low_power_mode", "battery_percent", "metal_available", "profiler_source", "collected_at_epoch_ms", "validity", "probe_errors", "raw_text_logged"],
  "properties": {
    "schema_version": {"const": "butler.device_profile.v1"},
    "platform": {"type": "string", "minLength": 1},
    "architecture": {"type": "string", "minLength": 1},
    "chip_family": {"type": "string", "minLength": 1, "maxLength": 80},
    "total_memory_bytes": {"type": ["integer", "null"], "minimum": 1},
    "available_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
    "process_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
    "memory_pressure": {"enum": ["NORMAL", "WARN", "CRITICAL", "UNKNOWN"]},
    "thermal_state": {"enum": ["NOMINAL", "FAIR", "SERIOUS", "CRITICAL", "UNKNOWN"]},
    "low_power_mode": {"type": ["boolean", "null"]},
    "battery_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "metal_available": {"type": ["boolean", "null"]},
    "profiler_source": {"type": "string", "minLength": 1},
    "collected_at_epoch_ms": {"type": "integer", "minimum": 0},
    "validity": {"enum": ["VALID", "UNKNOWN", "INVALID"]},
    "probe_errors": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"}, "uniqueItems": true},
    "raw_text_logged": {"const": false}
  }
}
