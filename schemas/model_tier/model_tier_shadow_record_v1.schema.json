{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/schemas/model_tier/shadow_record.schema.json",
  "title": "Butler model tier shadow record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timestamp_epoch_ms", "request_digest", "box_id", "task_profile_digest", "device_profile_digest", "policy_digest", "decision_digest", "recommended_tier", "recommended_variant_id", "reason_codes", "high_eligible", "gate_reason_code", "would_escalate", "actual_model_selection_unchanged", "actual_response_digest", "raw_text_logged", "external_send_zero", "previous_record_digest", "record_digest"],
  "properties": {
    "schema_version": {"const": "butler.model_tier_shadow.v1"},
    "timestamp_epoch_ms": {"type": "integer", "minimum": 0},
    "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "box_id": {"enum": ["1", "3"]},
    "task_profile_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "device_profile_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "recommended_tier": {"enum": ["MODEL_NONE", "TIER_1P7B", "TIER_4B"]},
    "recommended_variant_id": {"type": ["string", "null"], "maxLength": 128},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"}, "uniqueItems": true},
    "high_eligible": {"type": "boolean"},
    "gate_reason_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{1,127}$"},
    "would_escalate": {"type": "boolean"},
    "actual_model_selection_unchanged": {"const": true},
    "actual_response_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "raw_text_logged": {"const": false},
    "external_send_zero": {"const": true},
    "previous_record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
