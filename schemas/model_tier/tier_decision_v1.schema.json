{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/schemas/model_tier/tier_decision.schema.json",
  "title": "Butler tier decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "box_id", "recommended_tier", "recommended_variant_id", "eligible_variant_ids", "reason_codes", "high_eligible", "shadow_only", "applied", "task_digest", "device_profile_digest", "policy_digest", "decision_digest"],
  "properties": {
    "schema_version": {"const": "butler.tier_decision.v1"},
    "box_id": {"enum": ["1", "3"]},
    "recommended_tier": {"enum": ["MODEL_NONE", "TIER_1P7B", "TIER_4B"]},
    "recommended_variant_id": {"type": ["string", "null"], "maxLength": 128},
    "eligible_variant_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"}, "uniqueItems": true},
    "high_eligible": {"type": "boolean"},
    "shadow_only": {"const": true},
    "applied": {"const": false},
    "task_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "device_profile_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "decision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
