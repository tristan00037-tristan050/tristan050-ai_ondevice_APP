{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/schemas/model_tier/task_profile.schema.json",
  "title": "Butler task profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "box_id", "task_class", "payload_digest", "input_chars", "attachment_count", "total_attachment_bytes", "estimated_input_tokens", "requested_output_tokens", "reference_count", "structured_output_required", "deterministic_path_available", "ambiguity_score", "quality_risk_flags", "security_risk_flags"],
  "properties": {
    "schema_version": {"const": "butler.task_profile.v1"},
    "box_id": {"enum": ["1", "3"]},
    "task_class": {"type": "string", "minLength": 1},
    "payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input_chars": {"type": "integer", "minimum": 0},
    "attachment_count": {"type": "integer", "minimum": 0},
    "total_attachment_bytes": {"type": "integer", "minimum": 0},
    "estimated_input_tokens": {"type": "integer", "minimum": 0},
    "requested_output_tokens": {"type": "integer", "minimum": 0},
    "reference_count": {"type": "integer", "minimum": 0},
    "structured_output_required": {"type": "boolean"},
    "deterministic_path_available": {"type": "boolean"},
    "ambiguity_score": {"type": "number", "minimum": 0, "maximum": 1},
    "quality_risk_flags": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"}, "uniqueItems": true},
    "security_risk_flags": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"}, "uniqueItems": true}
  }
}
