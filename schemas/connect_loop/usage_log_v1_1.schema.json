{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://butler.local/schemas/connect_loop/usage_log_v1_1.schema.json",
  "title": "Connect Loop — Usage Log (v1.1)",
  "description": "한 요청의 연결 루프 결과를 감사/통계/후보탐색 목적으로 남기는 digest-only 로그. 이것은 학습 데이터가 아니다(retention_class=audit_digest_only). 원문은 어떤 필드에도 담지 않으며 external_send_zero/raw_text_logged 상수로 fail-closed 보장. unknown field는 fail-closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "log_id",
    "timestamp",
    "request_id",
    "device_id_digest",
    "tenant_id_digest",
    "department_id_digest",
    "request_digest",
    "intent_label",
    "box_id",
    "endpoint",
    "routing_confidence",
    "integration_mode",
    "real_validation_done",
    "result_digest",
    "source_digests",
    "policy_decision",
    "policy_reason_code",
    "latency_ms",
    "external_send_zero",
    "raw_text_logged",
    "learning_candidate",
    "learning_event_created",
    "retention_class",
    "created_by_component",
    "schema_hash",
    "schema_version"
  ],
  "properties": {
    "log_id": {
      "type": "string",
      "description": "로그 레코드 고유 ID.",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "description": "이벤트 발생 시각 (RFC3339 / ISO8601). Codex P2 정정 (2026-05-30): format 미검증 validator(Draft7Validator.validate)에서도 impossible timestamp(예: 2026-13-40T99:99:99Z)/invalid offset 을 차단하도록 expires_at 과 동일한 range pattern(month 01-12·day 01-31·hour 00-23·min/sec 00-59·offset 00-23:00-59) 적용.",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d+)?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$"
    },
    "request_id": {
      "type": "string",
      "description": "대응되는 chat_request / router_decision의 request_id.",
      "minLength": 1
    },
    "device_id_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tenant_id_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "department_id_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "request_digest": {
      "type": "string",
      "description": "요청 내용의 sha256 digest (원문 아님).",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "intent_label": {
      "type": "string",
      "enum": [
        "memory_search",
        "form_convert",
        "draft_write",
        "accounting_classify",
        "general_chat",
        "unknown"
      ]
    },
    "box_id": {
      "type": "string",
      "enum": ["helper1", "2", "3", "5", "chat", "none"]
    },
    "endpoint": {
      "type": "string",
      "description": "실측 sidecar 엔드포인트. router_decision.target_endpoint와 동일 enum.",
      "enum": [
        "POST /v1/helpers/1/search",
        "POST /v1/cards/2/rewrite",
        "POST /v1/cards/3/draft",
        "POST /accounting/classify",
        "none"
      ]
    },
    "routing_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "integration_mode": {
      "type": "string",
      "description": "real=실제 엔드포인트 호출됨, contract_only=계약만(엔드포인트 미연결/모의).",
      "enum": ["real", "contract_only"]
    },
    "real_validation_done": {
      "type": "boolean",
      "description": "실제 엔드포인트 응답에 대한 검증 수행 여부."
    },
    "result_digest": {
      "type": "string",
      "description": "결과(응답)의 sha256 digest. 원문 응답 아님.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_digests": {
      "type": "array",
      "description": "근거 소스의 sha256 digest 목록. 소스 문서명/원문 금지.",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "policy_decision": {
      "type": "string",
      "enum": ["allow", "deny", "review_required"]
    },
    "policy_reason_code": {
      "type": "string",
      "description": "정책 판정 사유 코드(대문자 코드, 원문 금지).",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "external_send_zero": {
      "description": "외부 전송 0건 불변식. 항상 true로 고정(위반 시 스키마 실패).",
      "const": true
    },
    "raw_text_logged": {
      "description": "원문 로깅 금지 불변식. 항상 false로 고정(위반 시 스키마 실패).",
      "const": false
    },
    "learning_candidate": {
      "type": "boolean",
      "description": "학습 후보로 탐색되었는지(통계/후보탐색용). true라도 학습 데이터가 되는 것은 아님 — learning_event 생성은 별도 정책/DLP/보존 통과 후."
    },
    "learning_event_created": {
      "type": "boolean",
      "description": "이 로그로부터 learning_event가 실제 생성되었는지."
    },
    "retention_class": {
      "description": "보존 분류 고정값. digest-only 감사 데이터임을 못박는다.",
      "const": "audit_digest_only"
    },
    "created_by_component": {
      "type": "string",
      "description": "이 로그를 생성한 컴포넌트 식별자(예: 'connect_loop.middleware'). 원문 금지, 식별자 형식만.",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "schema_hash": {
      "type": "string",
      "description": "사용된 스키마 본문의 sha256 digest. 계약 드리프트 감지용.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schema_version": {
      "type": "string",
      "const": "usage_log.v1.1"
    }
  },
  "allOf": [
    {
      "comment": "Codex P2 정정 (2026-05-27): intent_label/box_id/endpoint가 독립 enum이라 router_decision validation 없이 독립 ingest될 때 inconsistent record(예: accounting_classify + helper1 + /v1/helpers/1/search)가 통과해 audit/statistics를 오염시키던 결함 정정. router_decision.schema의 intent→box/endpoint 매핑을 box_id/endpoint 필드명으로 mirror.",
      "if": {
        "properties": { "intent_label": { "const": "memory_search" } },
        "required": ["intent_label"]
      },
      "then": {
        "properties": {
          "box_id": { "const": "helper1" },
          "endpoint": { "const": "POST /v1/helpers/1/search" }
        }
      }
    },
    {
      "if": {
        "properties": { "intent_label": { "const": "form_convert" } },
        "required": ["intent_label"]
      },
      "then": {
        "properties": {
          "box_id": { "const": "2" },
          "endpoint": { "const": "POST /v1/cards/2/rewrite" }
        }
      }
    },
    {
      "if": {
        "properties": { "intent_label": { "const": "draft_write" } },
        "required": ["intent_label"]
      },
      "then": {
        "properties": {
          "box_id": { "const": "3" },
          "endpoint": { "const": "POST /v1/cards/3/draft" }
        }
      }
    },
    {
      "if": {
        "properties": { "intent_label": { "const": "accounting_classify" } },
        "required": ["intent_label"]
      },
      "then": {
        "properties": {
          "box_id": { "const": "5" },
          "endpoint": { "const": "POST /accounting/classify" }
        }
      }
    },
    {
      "if": {
        "properties": { "intent_label": { "const": "general_chat" } },
        "required": ["intent_label"]
      },
      "comment": "Codex P1 정정 (2026-05-27): chat은 sidecar 미등록(serving server 별도)이라 Connect Loop sidecar 로그에서는 endpoint 'none'. box_id는 chat 의도 분류 유지.",
      "then": {
        "properties": {
          "box_id": { "const": "chat" },
          "endpoint": { "const": "none" }
        }
      }
    },
    {
      "if": {
        "properties": { "intent_label": { "const": "unknown" } },
        "required": ["intent_label"]
      },
      "then": {
        "properties": {
          "box_id": { "const": "none" },
          "endpoint": { "const": "none" }
        }
      }
    },
    {
      "comment": "Codex P2 정정 (2026-05-30): endpoint 'none'(general_chat/unknown fallback)은 실제 sidecar 호출이 아니므로 integration_mode='real' / real_validation_done=true 를 주장할 수 없다. fallback/no-endpoint 레코드가 측정된 real validation 으로 위장해 audit/통계(real vs fallback/contract-only 구분)를 오염시키는 것을 차단한다. endpoint 기준으로 강제하여 general_chat·unknown 양쪽을 모두 커버한다.",
      "if": {
        "properties": { "endpoint": { "const": "none" } },
        "required": ["endpoint"]
      },
      "then": {
        "properties": {
          "integration_mode": { "const": "contract_only" },
          "real_validation_done": { "const": false }
        }
      }
    }
  ]
}
