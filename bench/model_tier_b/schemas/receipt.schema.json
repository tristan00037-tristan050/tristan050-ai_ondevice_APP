{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:butler:model-tier-b:receipt:v2.8",
  "type":"object","additionalProperties":false,
  "required":["schema_version","receipt_type","run_id","subject","parents","payload","created_at_utc","canonicalization","receipt_sha256"],
  "properties":{"schema_version":{"const":"butler.model-tier-b.receipt.v2.8"},"receipt_type":{"type":"string","pattern":"^[a-z][A-Za-z0-9_]{0,63}$"},"run_id":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"},"subject":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/subject"}},"parents":{"type":"array","uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["receipt_sha256"],"properties":{"receipt_sha256":{"$ref":"#/$defs/sha256"}}}},"payload":{"type":"object"},"created_at_utc":{"type":"string","format":"date-time"},"canonicalization":{"const":"RFC8785-JCS-IINTEGER"},"receipt_sha256":{"$ref":"#/$defs/sha256"}},
  "$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"subject":{"type":"object","additionalProperties":false,"required":["name","sha256"],"properties":{"name":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256"}}}}
}
