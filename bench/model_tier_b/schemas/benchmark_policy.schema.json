{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:butler:model-tier-b:benchmark-policy:v2.8",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","approval_status","approver_identity","approval_expiry_utc","fixture_manifest_sha256","candidates","quality_floor_by_task","quality_noninferiority_margin_by_task","ttft_slo_ms_by_task","p95_e2e_slo_ms_by_task","peak_rss_limit_bytes","available_memory_floor_bytes","max_repair_rate","max_cascade_rate","worker_deadline_seconds","min_co_residency_seconds","sampler_interval_ms","max_missed_sample_ratio","tokenizer_manifest_sha256","bootstrap_seed","bootstrap_iterations","energy_required"],
  "properties":{
    "schema_version":{"const":"butler.model-tier-b.benchmark-policy.v2.8"},
    "approval_status":{"const":"APPROVED"},
    "approver_identity":{"type":"string","minLength":3,"pattern":"^[^*?]+$"},
    "approval_expiry_utc":{"type":"string","format":"date-time"},
    "fixture_manifest_sha256":{"$ref":"#/$defs/sha256"},
    "candidates":{"type":"object","additionalProperties":false,"required":["A","B"],"properties":{"A":{"$ref":"#/$defs/candidate"},"B":{"$ref":"#/$defs/candidate"}}},
    "quality_floor_by_task":{"$ref":"#/$defs/taskFractions"},
    "quality_noninferiority_margin_by_task":{"$ref":"#/$defs/taskFractions"},
    "ttft_slo_ms_by_task":{"$ref":"#/$defs/taskPositiveIntegers"},
    "p95_e2e_slo_ms_by_task":{"$ref":"#/$defs/taskPositiveIntegers"},
    "peak_rss_limit_bytes":{"type":"integer","minimum":1},
    "available_memory_floor_bytes":{"type":"integer","minimum":1},
    "max_repair_rate":{"$ref":"#/$defs/fraction"},
    "max_cascade_rate":{"$ref":"#/$defs/fraction"},
    "worker_deadline_seconds":{"type":"integer","minimum":1},
    "min_co_residency_seconds":{"type":"integer","minimum":1},
    "sampler_interval_ms":{"type":"integer","minimum":1},
    "max_missed_sample_ratio":{"$ref":"#/$defs/fraction"},
    "tokenizer_manifest_sha256":{"$ref":"#/$defs/sha256"},
    "bootstrap_seed":{"type":"integer"},
    "bootstrap_iterations":{"type":"integer","minimum":1000},
    "energy_required":{"type":"boolean"}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "fraction":{"oneOf":[{"type":"integer","minimum":0,"maximum":1000000},{"type":"string","pattern":"^(?:0(?:\\.[0-9]{1,6})?|1(?:\\.0{1,6})?)$"}]},
    "candidate":{"type":"object","additionalProperties":false,"required":["variant_id","model_manifest_sha256","runtime_config_sha256"],"properties":{"variant_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9@:/_.+-]{2,255}$"},"model_manifest_sha256":{"$ref":"#/$defs/sha256"},"runtime_config_sha256":{"$ref":"#/$defs/sha256"}}},
    "taskFractions":{"type":"object","minProperties":1,"propertyNames":{"pattern":"^[A-Za-z0-9_.-]{1,64}$"},"additionalProperties":{"$ref":"#/$defs/fraction"}},
    "taskPositiveIntegers":{"type":"object","minProperties":1,"propertyNames":{"pattern":"^[A-Za-z0-9_.-]{1,64}$"},"additionalProperties":{"type":"integer","minimum":1}}
  }
}
