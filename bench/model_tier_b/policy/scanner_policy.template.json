{
  "schema_version": "butler.model-tier-b.scanner-policy.v2.8",
  "unregistered_file_action": "BLOCK",
  "unregistered_binary_action": "BLOCK",
  "encodings": [
    "ASCII",
    "UTF-8",
    "UTF-16LE",
    "UTF-16BE"
  ],
  "max_depth": 4,
  "max_entries": 10000,
  "max_total_expanded_bytes": 1073741824,
  "max_single_file_bytes": 536870912,
  "max_compression_ratio": 100,
  "registered_binary_profiles": [],
  "forbidden_path_kinds": [
    "absolute",
    "parent_traversal",
    "symlink",
    "special",
    "casefold_collision"
  ]
}
