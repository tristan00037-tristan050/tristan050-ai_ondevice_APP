#!/bin/bash
# Butler sidecar launcher — Tauri externalBin 래퍼
# 이 스크립트는 butler_sidecar.py를 찾아 적절한 Python으로 실행한다.
# Python 우선순위:
#   1) BUTLER_PYTHON 환경 변수 (사용자가 명시한 경로)
#   2) 앱 번들 내부 Python 후보
#   3) system python3 (fallback — 의존성 미설치 시 endpoint 등록 실패 가능)
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# 1) 앱 번들 내부 Resources 경로 (프로덕션)
BUNDLE_SIDECAR="${SCRIPT_DIR}/../Resources/butler_sidecar.py"
# 2) 개발환경 — src-tauri/binaries 기준 상위 경로 (binaries → src-tauri → butler-desktop → root)
DEV_SIDECAR="${SCRIPT_DIR}/../../../butler_sidecar.py"

if [[ -f "$BUNDLE_SIDECAR" ]]; then
    SIDECAR_PY="$BUNDLE_SIDECAR"
    WORK_DIR="$(dirname "$BUNDLE_SIDECAR")"
    RUN_DIR="${HOME}/Library/Application Support/com.butler.desktop"
elif [[ -f "$DEV_SIDECAR" ]]; then
    SIDECAR_PY="$(realpath "$DEV_SIDECAR")"
    WORK_DIR="$(dirname "$SIDECAR_PY")"
    RUN_DIR="$WORK_DIR"
else
    echo "[butler-sidecar] ERROR: butler_sidecar.py not found" >&2
    exit 1
fi

export PYTHONPATH="$WORK_DIR:${PYTHONPATH:-}"
mkdir -p "$RUN_DIR"
cd "$RUN_DIR"

# ── Python 영역 탐지 ───────────────────────────────────────────
PYTHON_BIN=""

# (1) 환경 변수 우선
if [[ -n "${BUTLER_PYTHON:-}" && -x "${BUTLER_PYTHON}" ]]; then
    case "${BUTLER_PYTHON}" in
        *"/Desktop/butler/tristan050-ai_ondevice_APP/.venv/bin/python")
            echo "[butler-sidecar] WARN: ignoring stale BUTLER_PYTHON=${BUTLER_PYTHON}" >&2
            ;;
        *)
            PYTHON_BIN="${BUTLER_PYTHON}"
            ;;
    esac
fi

# (2) 앱 번들 내부 Python 후보
if [[ -z "$PYTHON_BIN" ]]; then
    for CANDIDATE in \
        "${SCRIPT_DIR}/../Resources/python/bin/python3" \
        "${SCRIPT_DIR}/../Resources/python/bin/python" \
        "${SCRIPT_DIR}/../Resources/.venv/bin/python" \
        "${SCRIPT_DIR}/../Frameworks/python/bin/python3" \
        "${SCRIPT_DIR}/../Frameworks/Python.framework/Versions/Current/bin/python3" \
        ; do
        if [[ -x "$CANDIDATE" ]]; then
            PYTHON_BIN="$CANDIDATE"
            break
        fi
    done
fi

# (3) system python3 fallback
if [[ -z "$PYTHON_BIN" ]]; then
    PYTHON_BIN="$(command -v python3 || echo python3)"
fi

# ── 내장 모델 기본 경로 (자립 앱) ─────────────────────────────
# BUTLER_MODEL_PATH 가 비어 있으면 자유대화 4B 전용 모델을 기본으로 사용한다.
# box3 1.7B 등 다른 모델은 메인으로 잡지 않는다. 사용자 명시 경로가 있으면 그대로 둔다.
if [[ -z "${BUTLER_MODEL_PATH:-}" ]]; then
    # 역할 분리(fail-closed): 자유대화 메인은 반드시 4B 전용.
    # box3 1.7B 등 다른 gguf를 메인으로 주입하지 않는다(오지정 우회 차단).
    FREE_CHAT_MODEL="${SCRIPT_DIR}/../Resources/models/qwen3-4b-q4_k_m.gguf"
    if [[ -f "$FREE_CHAT_MODEL" ]]; then
        export BUTLER_MODEL_PATH="$FREE_CHAT_MODEL"
        echo "[butler-sidecar] BUTLER_MODEL_PATH (free-chat 4B): $BUTLER_MODEL_PATH" >&2
    else
        echo "[butler-sidecar] WARN: free-chat 4B model not found; BUTLER_MODEL_PATH unset (fail-closed)" >&2
    fi
fi

echo "[butler-sidecar] Python: $PYTHON_BIN" >&2
echo "[butler-sidecar] Sidecar: $SIDECAR_PY" >&2
echo "[butler-sidecar] Workdir: $(pwd)" >&2
exec "$PYTHON_BIN" "$SIDECAR_PY" "$@"
