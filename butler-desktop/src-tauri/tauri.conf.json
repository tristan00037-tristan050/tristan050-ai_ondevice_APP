{
  "productName": "Butler",
  "version": "../package.json",
  "identifier": "com.butler.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && ../scripts/build_runtime.sh"
  },
  "app": {
    "windows": [
      {
        "title": "Butler",
        "width": 900,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765 http://localhost:8765; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../butler_sidecar.py": "butler_sidecar.py",
      "../../butler_pc_core": "butler_pc_core",
      "../../requirements-serving.txt": "requirements-serving.txt",
      "python-runtime": "python",
      "models": "models",
      "../../schemas": "schemas"
    }
  }
}
