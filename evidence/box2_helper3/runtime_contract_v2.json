{
  "schema_version": "box2.helper3.runtime_contract.v2",
  "requirements_file": "requirements-box2-helper3.txt",
  "install_script": "install_runtime.sh",
  "required_packages": [
    "mlx-lm",
    "peft",
    "transformers"
  ],
  "required_import_modules": {
    "mlx_lm": "mlx_lm",
    "peft": "peft",
    "transformers": "transformers"
  },
  "break_system_packages_default": false,
  "break_system_packages_allowed_only_when": "BUTLER_ALLOW_BREAK_SYSTEM_PACKAGES=1",
  "model_chain_status_fields": {
    "runtime_available": "bool",
    "runtime_packages": {
      "mlx_lm": "bool",
      "peft": "bool",
      "transformers": "bool"
    }
  },
  "missing_runtime_behavior": {
    "load_mode": [
      "contract_only",
      "blocked"
    ],
    "real_pass_allowed": false
  },
  "external_send": 0,
  "raw_persistence": 0
}
