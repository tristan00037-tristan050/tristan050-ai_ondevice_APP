{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/schemas/chart_of_accounts.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_profile_id",
    "company",
    "accounting_standard",
    "source_document",
    "code_policy",
    "unverified_fields",
    "account_count",
    "accounts"
  ],
  "properties": {
    "schema_version": {
      "const": "butler.box5.chart_of_accounts.v1"
    },
    "policy_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "company": {
      "type": "string",
      "minLength": 1
    },
    "accounting_standard": {
      "type": "string",
      "minLength": 1
    },
    "source_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "statements", "provided_by", "provided_at", "binding_note"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "statements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "provided_by": {"type": "string", "minLength": 1},
        "provided_at": {"type": "string", "format": "date"},
        "binding_note": {"type": "string", "minLength": 1}
      }
    },
    "code_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codes_present_in_source", "rule", "stable_key"],
      "properties": {
        "codes_present_in_source": {"const": false},
        "rule": {"type": "string", "minLength": 1},
        "stable_key": {"const": "account_id (문자열, 불변)"}
      }
    },
    "unverified_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "account_count": {
      "const": 85
    },
    "accounts": {
      "type": "array",
      "minItems": 85,
      "maxItems": 85,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "account_id",
          "code",
          "code_source",
          "name_ko",
          "account_type",
          "normal_balance",
          "cash_flow_default",
          "tax_behavior",
          "active_from",
          "active_to",
          "parent_account_id",
          "display_order",
          "policy_profile_id",
          "bank_txn_candidate",
          "note"
        ],
        "properties": {
          "account_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z0-9_]+)*$"
          },
          "code": {
            "type": "null"
          },
          "code_source": {
            "const": "NOT_IN_APPROVED_TEMPLATE"
          },
          "name_ko": {
            "type": "string",
            "minLength": 1
          },
          "account_type": {
            "enum": [
              "ASSET",
              "CONTRA_ASSET",
              "LIABILITY",
              "EQUITY",
              "REVENUE",
              "EXPENSE"
            ]
          },
          "normal_balance": {
            "enum": [
              "DEBIT",
              "CREDIT"
            ]
          },
          "cash_flow_default": {
            "enum": [
              "OPERATING",
              "INVESTING",
              "FINANCING",
              "NONE",
              "UNVERIFIED"
            ]
          },
          "tax_behavior": {
            "const": "UNVERIFIED_REQUIRES_FINANCE_APPROVAL"
          },
          "active_from": {
            "type": "string",
            "format": "date"
          },
          "active_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "parent_account_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_order": {
            "type": "integer",
            "minimum": 0
          },
          "policy_profile_id": {
            "const": "atlink.smb.v1"
          },
          "bank_txn_candidate": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
