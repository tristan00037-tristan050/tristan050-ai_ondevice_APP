{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "butler.box5.canonical_transaction.v1",
  "title": "Box5 stage-3 canonical transaction (non-PII classification view)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "company_id",
    "request_id",
    "transaction_id",
    "source_bank_id",
    "booked_date",
    "value_date",
    "direction",
    "amount_minor",
    "currency",
    "currency_registry_version",
    "transaction_digest",
    "source_record_digest"
  ],
  "properties": {
    "schema_version": {"const": "butler.box5.canonical_transaction.v2"},
    "tenant_id": {"$ref": "#/$defs/id"},
    "company_id": {"$ref": "#/$defs/id"},
    "request_id": {"$ref": "#/$defs/id"},
    "transaction_id": {"$ref": "#/$defs/id"},
    "source_bank_id": {"$ref": "#/$defs/id"},
    "booked_date": {"$ref": "#/$defs/date"},
    "value_date": {"$ref": "#/$defs/date"},
    "direction": {"enum": ["INFLOW", "OUTFLOW"]},
    "amount_minor": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "currency_registry_version": {"$ref": "#/$defs/id"},
    "transaction_digest": {"$ref": "#/$defs/digest"},
    "source_record_digest": {"$ref": "#/$defs/digest"},
    "counterparty_account_token": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/token"}]},
    "vendor_token": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/token"}]},
    "purpose_code": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}]},
    "purpose_evidence_digest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "description_feature_digests": {"type": "array", "items": {"$ref": "#/$defs/digest"}, "maxItems": 128, "uniqueItems": true},
    "evidence_digests": {"type": "array", "items": {"$ref": "#/$defs/digest"}, "maxItems": 128, "uniqueItems": true},
    "service_period_start": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]},
    "service_period_end": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]},
    "accounting_period_end": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]},
    "event_kind": {"enum": ["NORMAL", "REFUND", "REVERSAL", "CANCELLATION"]},
    "original_transaction_digest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "adjustment_reason_code": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "token": {"type": "string", "pattern": "^tok_[A-Za-z0-9_-]{16,128}$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
