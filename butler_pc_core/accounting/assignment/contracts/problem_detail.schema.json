{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/schemas/problem-detail-2.0.json",
  "title": "Butler Problem Detail",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "title", "status", "code", "request_id", "safe_detail", "actions"],
  "properties": {
    "type": {"type": "string", "format": "uri"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "status": {"type": "integer", "minimum": 400, "maximum": 599},
    "code": {"type": "string", "pattern": "^[A-Z0-9_]{3,80}$"},
    "request_id": {"type": "string", "minLength": 8, "maxLength": 128},
    "safe_detail": {"type": "string", "maxLength": 300},
    "actions": {"type": "array", "maxItems": 5, "items": {"type": "string", "maxLength": 80}},
    "current_version": {"type": ["integer", "null"], "minimum": 1},
    "conflict_id": {"type": "string", "minLength": 16, "maxLength": 128},
    "conflict_version": {"type": "integer", "minimum": 1},
    "existing_account_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "proposed_account_id": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
