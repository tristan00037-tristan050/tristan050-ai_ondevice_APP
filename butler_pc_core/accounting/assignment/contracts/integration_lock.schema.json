{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/schemas/integration-lock-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "base_commit",
    "base_tree",
    "integration_branch",
    "route_inventory_digest",
    "contract_closure_digest",
    "ui_tokens_digest",
    "source_zip_digests",
    "allowed_paths",
    "owner",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "butler.integration_lock.v1"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "integration_branch": {
      "type": "string",
      "minLength": 1
    },
    "route_inventory_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract_closure_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ui_tokens_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_zip_digests": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "allowed_paths": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
