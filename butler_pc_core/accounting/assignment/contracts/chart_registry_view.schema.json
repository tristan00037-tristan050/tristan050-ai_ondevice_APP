{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/schemas/accounting/chart-registry-view-2.0.json",
  "title": "Chart of Accounts Registry View",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_digest", "overlay_digest", "locale", "entries", "etag"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "registry_digest": {"$ref": "#/$defs/sha256"},
    "overlay_digest": {"$ref": "#/$defs/sha256"},
    "locale": {"type": "string", "minLength": 2, "maxLength": 32},
    "entries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/entry"}},
    "etag": {"type": "string", "minLength": 8, "maxLength": 160}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["account_id", "account_code", "display_name", "category_path", "node_kind", "assignable", "disabled_reason", "sort_order"],
      "properties": {
        "account_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "account_code": {"type": ["string", "null"], "maxLength": 64},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "category_path": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "node_kind": {"enum": ["POSTING", "GROUP", "CALCULATED", "CONTRA", "UNVERIFIED"]},
        "assignable": {"type": "boolean"},
        "disabled_reason": {"type": ["string", "null"], "maxLength": 160},
        "sort_order": {"type": "integer", "minimum": 0}
      }
    }
  }
}
