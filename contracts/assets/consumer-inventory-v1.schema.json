{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/contracts/consumer-inventory-v1.schema.json",
  "title": "Butler Consumer Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_head", "consumers"],
  "properties": {
    "schema_version": {"const": 1},
    "repository_head": {"type": "object"},
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_file", "symbol", "role", "current_authority", "target_authority", "migration_status", "owner", "test_id"],
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "source_file": {"type": "string", "minLength": 1},
          "symbol": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 2},
          "current_authority": {"type": "string", "minLength": 2},
          "target_authority": {"const": "AssetAuthority.acquire"},
          "migration_status": {"enum": ["PENDING", "MIGRATED", "BLOCKED"]},
          "owner": {"type": "string", "minLength": 2},
          "test_id": {"type": "string", "minLength": 3}
        }
      }
    }
  }
}
