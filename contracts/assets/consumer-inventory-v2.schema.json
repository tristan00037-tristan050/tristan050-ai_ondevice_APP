{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/contracts/consumer-inventory-v2.schema.json",
  "title": "Butler Static Consumer Inventory v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "consumers"],
  "properties": {
    "schema_version": {"const": 2},
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "language",
          "source_path",
          "symbol",
          "asset_role",
          "authority_api",
          "test_node_id"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
          "language": {"enum": ["python", "rust", "swift", "typescript", "cpp"]},
          "source_path": {"type": "string", "minLength": 1, "maxLength": 512},
          "symbol": {"type": "string", "minLength": 1, "maxLength": 512},
          "asset_role": {"type": "string", "minLength": 2, "maxLength": 128},
          "authority_api": {"const": "AssetAuthority.acquire"},
          "test_node_id": {"type": "string", "minLength": 3, "maxLength": 512}
        }
      }
    }
  }
}
