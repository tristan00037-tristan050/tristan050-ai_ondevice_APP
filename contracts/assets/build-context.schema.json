{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.invalid/contracts/build-context.schema.json",
  "title": "Butler Asset Build Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "build_id",
    "source_commit",
    "source_tree",
    "release_profile",
    "manifest_set_sha256",
    "toolchain"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "build_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "release_profile": {
      "enum": [
        "production",
        "development",
        "test"
      ]
    },
    "manifest_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "toolchain": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
