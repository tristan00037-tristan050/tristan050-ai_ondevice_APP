{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/contracts/loaded-model-receipt-v1.schema.json",
  "title": "Butler Loaded Model Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "nonce",
    "asset_role",
    "asset_sha256",
    "mapped_asset_sha256",
    "mapped_length",
    "loader_binary_sha256",
    "native_backend_sha256",
    "platform_seal",
    "result",
    "reason_code"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "format": "uuid"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{32,128}$"},
    "asset_role": {"type": "string", "minLength": 2, "maxLength": 128},
    "asset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mapped_asset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mapped_length": {"type": "integer", "minimum": 1},
    "loader_binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "native_backend_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "platform_seal": {
      "enum": ["linux_memfd", "macos_native_mapping", "macos_signed_bundle"]
    },
    "result": {"enum": ["ALLOW", "BLOCK"]},
    "reason_code": {"type": "string", "pattern": "^(OK|BLOCK_[A-Z0-9_]+)$"}
  }
}
