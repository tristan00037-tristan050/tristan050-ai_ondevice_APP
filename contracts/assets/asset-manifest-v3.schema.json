{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/contracts/asset-manifest-v3.schema.json",
  "title": "Butler Asset Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_set_digest", "source_oid", "source_tree_oid", "assets"],
  "properties": {
    "schema_version": {"const": 3},
    "manifest_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_oid": {"$ref": "#/$defs/git_oid"},
    "source_tree_oid": {"$ref": "#/$defs/git_oid"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    }
  },
  "$defs": {
    "git_oid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "hex"],
      "properties": {
        "algorithm": {"enum": ["sha1", "sha256"]},
        "hex": {"type": "string", "pattern": "^[0-9a-f]+$"}
      },
      "allOf": [
        {"if": {"properties": {"algorithm": {"const": "sha1"}}}, "then": {"properties": {"hex": {"minLength": 40, "maxLength": 40}}}},
        {"if": {"properties": {"algorithm": {"const": "sha256"}}}, "then": {"properties": {"hex": {"minLength": 64, "maxLength": 64}}}}
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "logical_name", "sha256", "size_bytes", "format"],
      "properties": {
        "role": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
        "logical_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "format": {"enum": ["gguf", "safetensors", "json", "sqlite", "binary"]}
      }
    }
  }
}
