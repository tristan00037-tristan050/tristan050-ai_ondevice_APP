{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.invalid/contracts/assets-manifest.schema.json",
  "title": "Butler Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_group",
    "group_version",
    "required_for_profiles",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "asset_group": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "group_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "required_for_profiles": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 8,
      "items": {
        "enum": [
          "production",
          "development",
          "test"
        ]
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "relative_path",
        "size_bytes",
        "sha256",
        "media_type",
        "validator"
      ],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\\\/:~\\u0000-\\u001F\\u007F-\\u009F]+(?:/[^\\\\/:~\\u0000-\\u001F\\u007F-\\u009F]+)*$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "enum": [
            "application/gguf",
            "application/json",
            "application/jsonl",
            "application/x-npy",
            "application/x-npz",
            "application/safetensors",
            "application/octet-stream",
            "text/plain"
          ]
        },
        "validator": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "allow_empty": {
          "type": "boolean",
          "default": false
        },
        "model_identity": {
          "$ref": "#/$defs/modelIdentity"
        }
      }
    },
    "modelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "version",
        "architecture"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "quantization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "base_model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tokenizer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
