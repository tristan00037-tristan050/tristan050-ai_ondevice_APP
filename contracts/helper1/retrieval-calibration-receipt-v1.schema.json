{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/contracts/helper1/retrieval-calibration-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evaluator_version", "evaluator_source_sha256",
    "encoder_provider", "encoder_model", "encoder_revision", "encoder_artifact_sha256",
    "corpus_manifest_sha256", "split_inventory_sha256", "group_inventory_sha256",
    "index_manifest_policy_sha256", "threshold_policy_sha256", "grounding_threshold_ppm",
    "abstention_threshold_ppm", "sample_count", "required_strata", "strata_counts",
    "prediction_rows_sha256", "label_rows_sha256", "evaluation_report_sha256",
    "counts", "metrics_ppm", "wrong_workspace_count", "stale_count", "span_violation_count"
  ],
  "properties": {
    "schema_version": {"const": "butler.helper1.retrieval-calibration-receipt.v1"},
    "evaluator_version": {"$ref": "#/$defs/id"},
    "evaluator_source_sha256": {"$ref": "#/$defs/digest"},
    "encoder_provider": {"$ref": "#/$defs/id"},
    "encoder_model": {"$ref": "#/$defs/id"},
    "encoder_revision": {"$ref": "#/$defs/id"},
    "encoder_artifact_sha256": {"$ref": "#/$defs/digest"},
    "corpus_manifest_sha256": {"$ref": "#/$defs/digest"},
    "split_inventory_sha256": {"$ref": "#/$defs/digest"},
    "group_inventory_sha256": {"$ref": "#/$defs/digest"},
    "index_manifest_policy_sha256": {"$ref": "#/$defs/digest"},
    "threshold_policy_sha256": {"$ref": "#/$defs/digest"},
    "grounding_threshold_ppm": {"$ref": "#/$defs/ppm"},
    "abstention_threshold_ppm": {"$ref": "#/$defs/ppm"},
    "sample_count": {"type": "integer", "minimum": 1},
    "required_strata": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "strata_counts": {"$ref": "#/$defs/countMap"},
    "prediction_rows_sha256": {"$ref": "#/$defs/digest"},
    "label_rows_sha256": {"$ref": "#/$defs/digest"},
    "evaluation_report_sha256": {"$ref": "#/$defs/digest"},
    "counts": {"$ref": "#/$defs/countMap"},
    "metrics_ppm": {"$ref": "#/$defs/ppmMap"},
    "wrong_workspace_count": {"type": "integer", "minimum": 0},
    "stale_count": {"type": "integer", "minimum": 0},
    "span_violation_count": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "countMap": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "ppmMap": {"type": "object", "additionalProperties": {"$ref": "#/$defs/ppm"}}
  }
}
