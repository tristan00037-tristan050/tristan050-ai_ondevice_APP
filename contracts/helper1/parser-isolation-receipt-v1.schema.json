{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/contracts/helper1/parser-isolation-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "key_id", "run_id", "request_id", "nonce_digest",
    "service_identity", "executable_sha256", "entitlements_sha256",
    "sandbox_policy_sha256", "input_sha256", "output_sha256",
    "network_denials", "file_denials", "process_denials",
    "started_monotonic_ns", "ended_monotonic_ns", "peak_memory_bytes",
    "issued_at_epoch_s", "expires_at_epoch_s", "terminal_status", "signature_b64"
  ],
  "properties": {
    "schema_version": {"const": "butler.helper1.parser-isolation-receipt.v1"},
    "key_id": {"$ref": "#/$defs/digest"},
    "run_id": {"$ref": "#/$defs/uuid"},
    "request_id": {"$ref": "#/$defs/uuid"},
    "nonce_digest": {"$ref": "#/$defs/digest"},
    "service_identity": {"type": "string", "minLength": 1, "maxLength": 200},
    "executable_sha256": {"$ref": "#/$defs/digest"},
    "entitlements_sha256": {"$ref": "#/$defs/digest"},
    "sandbox_policy_sha256": {"$ref": "#/$defs/digest"},
    "input_sha256": {"$ref": "#/$defs/digest"},
    "output_sha256": {"$ref": "#/$defs/digest"},
    "network_denials": {"type": "integer", "minimum": 0},
    "file_denials": {"type": "integer", "minimum": 0},
    "process_denials": {"type": "integer", "minimum": 0},
    "started_monotonic_ns": {"type": "integer", "minimum": 0},
    "ended_monotonic_ns": {"type": "integer", "minimum": 1},
    "peak_memory_bytes": {"type": "integer", "minimum": 0},
    "issued_at_epoch_s": {"type": "integer", "minimum": 0},
    "expires_at_epoch_s": {"type": "integer", "minimum": 1},
    "terminal_status": {"enum": ["SUCCESS", "BLOCKED", "CRASHED", "TIMEOUT"]},
    "signature_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {"type": "string", "format": "uuid"}
  }
}
