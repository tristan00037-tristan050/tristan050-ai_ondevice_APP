{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/contracts/helper1/retrieval-sealed-test-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evaluator_version", "evaluator_source_sha256",
    "encoder_provider", "encoder_model", "encoder_revision", "encoder_artifact_sha256",
    "corpus_manifest_sha256", "split_inventory_sha256", "group_inventory_sha256",
    "index_manifest_policy_sha256", "threshold_policy_sha256", "grounding_threshold_ppm",
    "abstention_threshold_ppm", "sample_count", "required_strata", "strata_counts",
    "prediction_rows_sha256", "label_rows_sha256", "evaluation_report_sha256",
    "counts", "metrics_ppm", "wrong_workspace_count", "stale_count", "span_violation_count",
    "calibration_payload_sha256", "sealed_dataset_manifest_sha256", "hidden_labels_sha256"
  ],
  "properties": {
    "schema_version": {"const": "butler.helper1.retrieval-sealed-test-receipt.v1"},
    "evaluator_version": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/id"},
    "evaluator_source_sha256": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/digest"},
    "encoder_provider": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/id"},
    "encoder_model": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/id"},
    "encoder_revision": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/id"},
    "encoder_artifact_sha256": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/digest"},
    "corpus_manifest_sha256": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/digest"},
    "split_inventory_sha256": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/digest"},
    "group_inventory_sha256": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/digest"},
    "index_manifest_policy_sha256": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/digest"},
    "threshold_policy_sha256": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/digest"},
    "grounding_threshold_ppm": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/ppm"},
    "abstention_threshold_ppm": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/ppm"},
    "sample_count": {"type": "integer", "minimum": 1},
    "required_strata": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/id"}},
    "strata_counts": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/countMap"},
    "prediction_rows_sha256": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/digest"},
    "label_rows_sha256": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/digest"},
    "evaluation_report_sha256": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/digest"},
    "counts": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/countMap"},
    "metrics_ppm": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/ppmMap"},
    "wrong_workspace_count": {"type": "integer", "minimum": 0},
    "stale_count": {"type": "integer", "minimum": 0},
    "span_violation_count": {"type": "integer", "minimum": 0},
    "calibration_payload_sha256": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/digest"},
    "sealed_dataset_manifest_sha256": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/digest"},
    "hidden_labels_sha256": {"$ref": "retrieval-calibration-receipt-v1.schema.json#/$defs/digest"}
  }
}
