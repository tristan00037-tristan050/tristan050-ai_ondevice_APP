{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://butler.local/schemas/home/v2.1/terminal_receipt.schema.json","type":"object","required":["schema_version","turn_id","model_request_id","terminal_type","terminal_count","assistant_message_count","committed_at","command_receipt","error_code"],"properties":{"schema_version":{"const":"2.1.0"},"turn_id":{"$ref":"common.schema.json#/$defs/uuid"},"model_request_id":{"$ref":"common.schema.json#/$defs/uuid"},"terminal_type":{"enum":["COMPLETED","FAILED","CANCELLED","TIMED_OUT"]},"terminal_count":{"const":1},"assistant_message_count":{"type":"integer","minimum":0,"maximum":1},"committed_at":{"$ref":"common.schema.json#/$defs/rfc3339"},"command_receipt":{"$ref":"command_receipt.schema.json"},"error_code":{"type":["string","null"],"pattern":"^[A-Z][A-Z0-9_]+$"}},"allOf":[{"if":{"properties":{"terminal_type":{"const":"COMPLETED"}},"required":["terminal_type"]},"then":{"properties":{"assistant_message_count":{"const":1},"error_code":{"const":null}}}},{"if":{"properties":{"terminal_type":{"enum":["FAILED","CANCELLED","TIMED_OUT"]}},"required":["terminal_type"]},"then":{"properties":{"assistant_message_count":{"const":0}}}}],"additionalProperties":false}
