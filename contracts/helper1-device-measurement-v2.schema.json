{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/contracts/helper1-device-measurement-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "run_attempt", "device_class", "hardware_model_identifier", "os_version", "os_build", "source_commit", "source_tree", "device_receipt_sha256", "receipt_key_id", "measurement_policy_sha256", "observer_name", "observer_version", "observer_binary_sha256", "sample_clock", "sample_interval_ns", "cold_samples", "warm_samples", "thermal_samples", "network_observation", "raw_bundle_sha256"],
  "properties": {
    "schema_version": {"const": "butler.helper1.device-measurement.v2"}, "run_id": {"type": "string", "minLength": 1}, "run_attempt": {"type": "integer", "minimum": 1}, "device_class": {"enum": ["M3", "M4"]}, "hardware_model_identifier": {"type": "string", "minLength": 1}, "os_version": {"type": "string", "minLength": 1}, "os_build": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "device_receipt_sha256": {"$ref": "#/$defs/digest"}, "receipt_key_id": {"$ref": "#/$defs/digest"}, "measurement_policy_sha256": {"$ref": "#/$defs/digest"}, "observer_name": {"type": "string", "minLength": 1}, "observer_version": {"type": "string", "minLength": 1}, "observer_binary_sha256": {"$ref": "#/$defs/digest"}, "sample_clock": {"const": "monotonic_ns"}, "sample_interval_ns": {"type": "integer", "minimum": 1}, "cold_samples": {"type": "array", "minItems": 1}, "warm_samples": {"type": "array", "minItems": 1}, "thermal_samples": {"type": "array", "minItems": 1}, "network_observation": {"type": "object", "required": ["delta_bytes", "raw_trace_sha256"], "properties": {"delta_bytes": {"const": 0}, "raw_trace_sha256": {"$ref": "#/$defs/digest"}}}, "raw_bundle_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
