{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:butler:firstscreen:revocations:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "version", "generated_at_utc", "expires_at_utc", "previous_digest", "root_policy_digest", "revoked_decision_ids", "revoked_key_ids", "revoked_epochs", "signatures"],
  "properties": {
    "schema_version": {"const": "butler.firstscreen.revocations.v2"},
    "policy_id": {"const": "butler-firstscreen-trust"},
    "version": {"type": "integer", "minimum": 1},
    "generated_at_utc": {"$ref": "#/$defs/utc"},
    "expires_at_utc": {"$ref": "#/$defs/utc"},
    "previous_digest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "root_policy_digest": {"$ref": "#/$defs/sha256"},
    "revoked_decision_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "revoked_key_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/key_id"}},
    "revoked_epochs": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "signatures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signature"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "key_id": {"type": "string", "pattern": "^ed25519\\.[0-9a-f]{64}$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "signature"],
      "properties": {"key_id": {"$ref": "#/$defs/key_id"}, "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}}
    }
  }
}
