{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:butler:firstscreen:risk-decision:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "decision_id", "version", "approved_at_utc", "expires_at_utc", "scope", "protection_boundary", "data_classification", "owner_role", "revocation_epoch", "root_policy_digest", "source_blob_digest", "canonical_ssot_location", "signatures"],
  "properties": {
    "schema_version": {"const": "butler.firstscreen.risk-decision.v2"},
    "policy_id": {"const": "butler-firstscreen-trust"},
    "decision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"type": "integer", "minimum": 1},
    "approved_at_utc": {"$ref": "#/$defs/utc"},
    "expires_at_utc": {"$ref": "#/$defs/utc"},
    "scope": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["CONVERSATION_TITLE", "FTS_TITLE_INDEX"]}},
    "protection_boundary": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["ON_DEVICE", "OS_USER_BOUNDARY", "APP_DATA_PATH", "OWNER_MODE_GUARD", "OPTIONAL_APP_SANDBOX"]}},
    "data_classification": {"const": "CONFIDENTIAL"},
    "owner_role": {"const": "ATLINK_REPRESENTATIVE"},
    "revocation_epoch": {"type": "integer", "minimum": 0},
    "root_policy_digest": {"$ref": "#/$defs/sha256"},
    "source_blob_digest": {"$ref": "#/$defs/sha256"},
    "canonical_ssot_location": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "signatures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signature"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "key_id": {"type": "string", "pattern": "^ed25519\\.[0-9a-f]{64}$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "signature"],
      "properties": {"key_id": {"$ref": "#/$defs/key_id"}, "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}}
    }
  }
}
