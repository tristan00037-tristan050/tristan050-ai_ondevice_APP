{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:butler:firstscreen:release-subjects:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "build_context_digest", "subjects", "created_at_utc", "signatures"],
  "properties": {
    "schema_version": {"const": "butler.firstscreen.release-subjects.v1"},
    "policy_id": {"const": "butler-firstscreen-trust"},
    "build_context_digest": {"$ref": "#/$defs/sha256"},
    "subjects": {
      "type": "object", "additionalProperties": false,
      "required": ["source_archive", "web_dist_archive", "macos_artifact", "sbom"],
      "properties": {
        "source_archive": {"$ref": "#/$defs/subject"},
        "web_dist_archive": {"$ref": "#/$defs/subject"},
        "macos_artifact": {"$ref": "#/$defs/subject"},
        "sbom": {"$ref": "#/$defs/subject"}
      }
    },
    "created_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "signatures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signature"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "key_id": {"type": "string", "pattern": "^ed25519\\.[0-9a-f]{64}$"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "size", "sha256", "build_context_digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "build_context_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["key_id", "signature"],
      "properties": {"key_id": {"$ref": "#/$defs/key_id"}, "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}}
    }
  }
}
