{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/contracts/learning-capability-success-v1.schema.json",
  "title": "Butler learning capability success v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "generation",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "const": "CANONICAL"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_rules",
        "company_facts",
        "company_formats",
        "folder_learning"
      ],
      "properties": {
        "company_rules": {
          "$ref": "#/$defs/canonical_status"
        },
        "company_facts": {
          "$ref": "#/$defs/canonical_status"
        },
        "company_formats": {
          "$ref": "#/$defs/canonical_status"
        },
        "folder_learning": {
          "$ref": "#/$defs/canonical_status"
        }
      }
    }
  },
  "$defs": {
    "canonical_status": {
      "enum": [
        "IN_USE",
        "REGISTERED_ONLY",
        "PREVIEW_ONLY"
      ]
    }
  }
}
