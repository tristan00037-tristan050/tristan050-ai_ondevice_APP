{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/contracts/helper1-evaluation-run-subject-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "run_attempt", "source_commit", "source_tree", "query_manifest_sha256", "corpus_manifest_sha256", "retrieval_policy_sha256", "threshold_policy_sha256", "threshold_approval_receipt_sha256", "encoder_space_sha256", "normal_index_manifest_sha256", "ablation_index_manifest_sha256", "generator_identity_sha256", "prompt_template_sha256", "decoding_policy_sha256", "seed"],
  "properties": {
    "schema_version": {"const": "butler.helper1.evaluation-run-subject.v2"},
    "run_id": {"$ref": "#/$defs/id"}, "run_attempt": {"type": "integer", "minimum": 1},
    "source_commit": {"$ref": "#/$defs/oid"}, "source_tree": {"$ref": "#/$defs/oid"},
    "query_manifest_sha256": {"$ref": "#/$defs/digest"}, "corpus_manifest_sha256": {"$ref": "#/$defs/digest"},
    "retrieval_policy_sha256": {"$ref": "#/$defs/digest"}, "threshold_policy_sha256": {"$ref": "#/$defs/digest"}, "threshold_approval_receipt_sha256": {"$ref": "#/$defs/digest"},
    "encoder_space_sha256": {"$ref": "#/$defs/digest"}, "normal_index_manifest_sha256": {"$ref": "#/$defs/digest"},
    "ablation_index_manifest_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "generator_identity_sha256": {"$ref": "#/$defs/digest"}, "prompt_template_sha256": {"$ref": "#/$defs/digest"},
    "decoding_policy_sha256": {"$ref": "#/$defs/digest"}, "seed": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
