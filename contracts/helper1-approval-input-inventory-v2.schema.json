{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://butler.local/contracts/helper1-approval-input-inventory-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "files"],
  "properties": {
    "schema_version": {"const": "butler.helper1.approval-input-inventory.v2"},
    "files": {
      "type": "object",
      "minProperties": 19,
      "maxProperties": 255,
      "propertyNames": {"pattern": "^(legacy|approval|objects)/[A-Za-z0-9_.-]+$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bytes", "sha256", "media_type", "role"],
        "properties": {
          "bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"type": "string", "minLength": 1, "maxLength": 256},
          "role": {"type": ["string", "null"], "maxLength": 96}
        }
      }
    }
  }
}
